# On EC2 this file is generated from SSM Parameter Store (/health-advisor/*).
ENV=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@RDS_ENDPOINT:5432/health_advisor
PHOENIX_SQL_DATABASE_URL=postgresql://USER:PASSWORD@RDS_ENDPOINT:5432/phoenix
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
API_DOMAIN=api.example.sslip.io
PHOENIX_BASIC_AUTH_HASH=
