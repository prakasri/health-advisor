# Copy to backend/.env and fill in. Never commit .env.
ENV=local
DATABASE_URL=postgresql+psycopg://health_advisor:health_advisor@localhost:5432/health_advisor
# Needed from Phase 4 onwards
ANTHROPIC_API_KEY=
# Only if the key is not scoped to a workspace (Console → Settings → Workspaces → copy the ID)
ANTHROPIC_WORKSPACE_ID=
LLM_MODEL=claude-sonnet-5
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT=health-advisor
LLM_EFFORT_WRITER=low
LLM_EFFORT_JUDGE=medium
TRACING_ENABLED=true
